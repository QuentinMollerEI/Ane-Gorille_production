rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🧠 1. FONCTIONS UTILITAIRES & CONTRÔLE D'ACCÈS SÉCURISÉ (RBAC)
    // =========================================================================

    // Vérifie si l'utilisateur est authentifié
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Vérifie si l'utilisateur accède à sa propre ressource par son UID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Récupération sécurisée des données utilisateur (Empêche les crashs si le document n'existe pas encore)
    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Récupération sécurisée du rôle principal
    function getUserRole() {
      return getUserData().get('role', '');
    }

    // Vérificateur de rôle Administrateur
    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'administrator' ||
        (request.auth.token != null && request.auth.token.get('role', '') == 'admin')
      );
    }

    // Vérificateurs de rôles spécifiques
    function isProducer() {
      return isSignedIn() && (
        getUserRole() == 'producteur' || 
        getUserRole() == 'producer' || 
        getUserRole() == 'fournisseur'
      );
    }

    function isCarrier() {
      return isSignedIn() && (
        getUserRole() == 'livreur' || 
        getUserRole() == 'carrier'
      );
    }

    function isBuyer() {
      return isSignedIn() && (
        getUserRole() == 'acheteur_prive' || 
        getUserRole() == 'acheteur_public' || 
        getUserRole() == 'client_pro' || 
        getUserRole() == 'client_public'
      );
    }


    // =========================================================================
    // 👤 2. COLLECTION : USERS (Profils & Paramètres Utilisateurs)
    // =========================================================================
    match /users/{userId} {
      // Lecture : Tout utilisateur authentifié peut consulter son profil et les profils utiles
      allow read: if isSignedIn();
      
      // Création : Un utilisateur inscrit crée son profil initial à la connexion
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Mise à jour : L'utilisateur met à jour son profil (sans modifier son rôle) ou l'admin
      allow update: if (
        isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      ) || isAdmin();
      
      // Suppression : Réservé aux administrateurs
      allow delete: if isAdmin();
    }


    // =========================================================================
    // 🥕 3. COLLECTION : PRODUCTS (Catalogue Produit & Stocks)
    // =========================================================================
    match /products/{productId} {
      // Lecture : Publique / Accessible à tous pour la boutique et la gestion
      allow read: if true;
      
      // Création / Modification / Suppression : Tout utilisateur connecté
      allow create, update, delete: if isSignedIn();
    }


    // =========================================================================
    // 📦 4. COLLECTION : ORDERS (Commandes Globales)
    // =========================================================================
    match /orders/{orderId} {
      // Lecture : L'acheteur de la commande, le producteur concerné, le livreur ou l'admin
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.producerId == request.auth.uid ||
        (resource.data.producerIds != null && request.auth.uid in resource.data.producerIds) ||
        (resource.data.producerIds != null && resource.data.producerIds.hasAny([request.auth.uid])) ||
        isProducer() ||
        isCarrier() ||
        isAdmin()
      );
      
      // Création : Tout utilisateur connecté lors de la validation du panier
      allow create: if isSignedIn();
      
      // Mise à jour : Tout utilisateur connecté concerné
      allow update: if isSignedIn();
      
      // Suppression : Réservé aux administrateurs
      allow delete: if isAdmin();
    }


    // =========================================================================
    // 🚜 5. COLLECTION : SUB_ORDERS (Sous-Commandes par Producteur)
    // =========================================================================
    match /sub_orders/{subOrderId} {
      // Lecture : Le producteur concerné, l'acheteur, le livreur ou tout producteur/admin connecté
      allow read: if isSignedIn() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isProducer() ||
        isCarrier() ||
        isAdmin()
      );
      
      // Création : Généré lors du checkout
      allow create: if isSignedIn();
      
      // Mise à jour (Lot HACCP, statut A_RAMASSER, etc.) : Tout utilisateur connecté concerné
      allow update: if isSignedIn();
      
      // Suppression : Administrateurs uniquement
      allow delete: if isAdmin();
    }


    // =========================================================================
    // 📄 6. COLLECTION : DOCUMENTS (Bons de Livraison & Factures Factur-X)
    // =========================================================================
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }


    // =========================================================================
    // 🚚 7. COLLECTION : ROUTES / TOURS (Feuilles de Route Logistiques)
    // =========================================================================
    match /routes/{routeId} {
      allow read, write: if isSignedIn();
    }


    // =========================================================================
    // 🏛️ 8. COLLECTION : CHORUS_QUEUE (File de Télétransmission B2G Chorus Pro)
    // =========================================================================
    match /chorus_queue/{queueId} {
      allow read, write: if isSignedIn();
    }


    // =========================================================================
    // 🛒 9. COLLECTION : CARTS (Paniers Individuels Réseau)
    // =========================================================================
    match /carts/{cartUserId} {
      allow read, write: if isSignedIn();
    }


    // =========================================================================
    // 🔒 10. VERROUILLAGE SÉCURITÉ GÉNÉRAL PAR DÉFAUT
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
