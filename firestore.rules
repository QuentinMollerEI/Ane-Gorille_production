rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 👤 1. PROFILS UTILISATEURS (Collection 'users')
    // =========================================================================
    match /users/{userId} {
      // Sécurité & RGPD : N'importe quel visiteur (connecté ou non) doit pouvoir résoudre
      // le nom d'un producteur ('get' individuel) pour afficher l'étal de la boutique.
      // Cependant, il est strictement interdit de lister l'ensemble de la base ('list' bloqué)
      // pour éviter le scraping des données des utilisateurs.
      allow get: if true;

      // Seul l'utilisateur propriétaire du compte peut modifier ses informations
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // 🌾 2. CATALOGUE DE PRODUITS (Collection 'products')
    // =========================================================================
    match /products/{productId} {
      // Lecture publique pour pouvoir afficher la boutique à tout visiteur (connecté ou non)
      allow read: if true;

      // Création : Seul un producteur (ou administrateur) peut ajouter un produit.
      allow create: if request.auth != null && (
        request.auth.token.role == 'producer' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'producteur'
      );

      // Mise à jour (Update) : Double verrouillage de sécurité
      allow update: if request.auth != null && (
        // Cas A : C'est le producteur propriétaire de la fiche qui modifie son produit
        (resource.data.producerId == request.auth.uid)
        ||
        // Cas B : C'est un acheteur connecté qui valide un panier et décrémente UNIQUEMENT le stock
        // (Empêche toute modification frauduleuse du prixHT, de la TVA ou du nom du produit).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']))
      );

      // Suppression : Seul le producteur propriétaire ou l'admin peut supprimer un produit
      allow delete: if request.auth != null && (
        resource.data.producerId == request.auth.uid ||
        request.auth.token.role == 'admin'
      );
    }

    // =========================================================================
    // 🛒 3. COMMANDES GLOBALES CLIENT (Collection 'orders')
    // =========================================================================
    match /orders/{orderId} {
      // Création : Autorisé à tout acheteur connecté
      allow create: if request.auth != null;

      // Lecture : L'acheteur peut voir ses propres commandes, et l'admin supervise le tout
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        request.auth.token.role == 'admin'
      );

      // Interdiction de modification ou de suppression directe après création (Conformité fiscale)
      allow update, delete: if false;
    }

    // =========================================================================
    // 🧑‍🌾 4. BONS DE PRÉPARATION MARAÎCHERS (Collection 'sub_orders')
    // =========================================================================
    match /sub_orders/{subOrderId} {
      // Création : Autorisé à tout acheteur connecté (appelé via le transaction batch du panier)
      allow create: if request.auth != null;

      // Lecture et mise à jour (logistique) :
      // - Un producteur ne peut lire et modifier (ex: passer à "Prêt pour le livreur") que SES propres bons de préparation.
      // - L'acheteur peut suivre l'état de sa commande.
      // - Le livreur peut consulter pour sa logistique.
      // - L'admin supervise l'ensemble.
      allow read, update: if request.auth != null && (
        resource.data.producerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        request.auth.token.role == 'livreur' ||
        request.auth.token.role == 'admin'
      );

      // Interdiction de suppression (traçabilité HACCP obligatoire)
      allow delete: if false;
    }
  }
}
