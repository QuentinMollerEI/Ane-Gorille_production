rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 👤 1. PROFILS UTILISATEURS (Collection 'users')
    // =========================================================================
    match /users/{userId} {
      // Sécurité & RGPD : Tout visiteur peut afficher l'étal individuel d'un producteur ('get')
      allow get: if true;

      // CORRECTIF SÉCURISÉ : Seul l'administrateur peut faire des requêtes de liste ou requêter
      // l'ensemble des vendeurs de l'éco-système (requis pour le bilan fiscal)
      allow list: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Écriture : Seul le propriétaire ou l'administrateur peut modifier ou valider un profil
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // =========================================================================
    // 🌾 2. CATALOGUE DE PRODUITS (Collection 'products')
    // =========================================================================
    match /products/{productId} {
      allow read: if true;

      allow create: if request.auth != null && (
        request.auth.token.role == 'producer' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'producteur' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow update: if request.auth != null && (
        (resource.data.producerId == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])) ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow delete: if request.auth != null && (
        resource.data.producerId == request.auth.uid ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // =========================================================================
    // 🛒 3. COMMANDES GLOBALES CLIENT (Collection 'orders')
    // =========================================================================
    match /orders/{orderId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow update, delete: if false; // Conformité comptable stricte
    }

    // =========================================================================
    // 🧑‍🌾 4. BONS DE PRÉPARATION MARAÎCHERS (Collection 'sub_orders')
    // =========================================================================
    match /sub_orders/{subOrderId} {
      allow create: if request.auth != null;

      allow read, update: if request.auth != null && (
        resource.data.producerId == request.auth.uid ||
        resource.data.producerId == "ID_PRODUCTEUR_TEST" ||
        resource.data.buyerId == request.auth.uid ||
        request.auth.token.role == 'livreur' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'livreur' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow delete: if false;
    }

    // =========================================================================
    // ⚙️ 5. CONFIGURATIONS RÉGLEMENTAIRES (Collection 'config')
    // =========================================================================
    match /config/{documentId} {
      // CORRECTIF CONFIG : Tout utilisateur authentifié peut lire les règles d'exploitation (commission 18%, etc.)
      allow read: if request.auth != null;

      // Sécurité absolue : Seul l'administrateur peut modifier ces paramètres à l'écran
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
