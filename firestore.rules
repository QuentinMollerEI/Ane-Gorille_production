rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🛡️ 1. FONCTIONS UTILITAIRES & CONTRÔLE D'ACCÈS SÉCURISÉ (RBAC VIA TOKEN)
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // LECTURE DIRECTE DU RÔLE DEPUIS LE TOKEN (Zéro coût de lecture Firestore)
    function getUserRole() {
      return request.auth.token != null ? request.auth.token.role : '';
    }

    // Vérificateurs de la matrice des rôles
    function isAdmin() { return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'administrator'); }
    function isProducer() { return isSignedIn() && (getUserRole() == 'producteur' || getUserRole() == 'producer'); }
    function isArtisan() { return isSignedIn() && getUserRole() == 'artisan'; }
    function isCarrier() { return isSignedIn() && (getUserRole() == 'livreur' || getUserRole() == 'carrier'); }
    function isPublicBuyer() { return isSignedIn() && (getUserRole() == 'acheteur_public' || getUserRole() == 'client_public'); }
    function isPrivateBuyer() { return isSignedIn() && (getUserRole() == 'acheteur_prive' || getUserRole() == 'client_pro'); }

    function isSeller() { return isProducer() || isArtisan(); }
    function isBuyer() { return isPublicBuyer() || isPrivateBuyer(); }

    // =========================================================================
    // 👤 2. COLLECTION : USERS
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Bloque la modification du rôle par l'utilisateur lui-même
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 🛒 3. COLLECTION : PRODUCTS (Catalogue Dual Âne/Gorille)
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSeller() || isAdmin();
    }

    // =========================================================================
    // 📦 4. COLLECTION : ORDERS & SUB_ORDERS
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isSeller() || isCarrier() || isAdmin());
      allow create: if isBuyer() || isAdmin();
      allow update: if isSignedIn(); 
      allow delete: if isAdmin();
    }

    match /sub_orders/{subOrderId} {
      allow read: if isSignedIn() && (resource.data.producerId == request.auth.uid || resource.data.buyerId == request.auth.uid || isCarrier() || isAdmin());
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 📄 5. DOCUMENTS, ROUTES, CHORUS & CARTS
    // =========================================================================
    match /documents/{docId} { allow read, write: if isSignedIn(); }
    match /routes/{routeId} { allow read, write: if isCarrier() || isAdmin(); }
    match /chorus_queue/{queueId} { allow read, write: if isPublicBuyer() || isAdmin(); }
    match /carts/{cartUserId} { allow read, write: if isOwner(cartUserId); }

    // =========================================================================
    // 🔒 6. VERROUILLAGE SÉCURITÉ GÉNÉRAL PAR DÉFAUT
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}